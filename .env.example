APP_ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
WORKER_NAME=local-worker
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
AUTH_ACCESS_TOKEN_COOKIE_NAME=insurance_operations_access_token
SUPABASE_AUTH_ISSUER=https://example.supabase.co/auth/v1
SUPABASE_AUTH_AUDIENCE=authenticated
SUPABASE_AUTH_JWKS_URL=https://example.supabase.co/auth/v1/.well-known/jwks.json
AUTH_CLOCK_SKEW_SECONDS=30
IDEMPOTENCY_RETENTION_HOURS=24
DATABASE_URL=postgresql+psycopg://user:password@pooled-host/database?sslmode=require
DIRECT_DATABASE_URL=postgresql+psycopg://user:password@direct-host/database?sslmode=require
TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost/insurance_operations_test
DATABASE_SSL_MODE=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=300
